-- Auto Shoot Murder standalone (tap to shoot)
local function createAutoShootStandaloneUI()
    if autoShootStandaloneFrame then return end

    local function shootMurderOnce()
        local player = LocalPlayer
        if getPlayerRole(player) ~= "Sheriff" then
            Notify("AUTO SHOOT", "You are not the Sheriff!")
            return
        end
        if not equipGun() then
            Notify("AUTO SHOOT", "Could not equip gun.")
            return
        end
        local murderer = getMurderer()
        if not murderer or not murderer.Character then
            Notify("AUTO SHOOT", "No murderer found.")
            return
        end
        local char = player.Character
        if not char then return end
        local gun = char:FindFirstChild("Gun")
        if not gun then
            Notify("AUTO SHOOT", "Gun not equipped.")
            return
        end
        local origin = char.HumanoidRootPart.Position
        local targetPos = murderer.Character.HumanoidRootPart.Position
        local direction = (targetPos - origin).Unit * 500
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char}
        local result = Workspace:Raycast(origin, direction, rayParams)
        if not result or not result.Instance:IsDescendantOf(murderer.Character) then
            Notify("AUTO SHOOT", "No line of sight to murderer.")
            return
        end
        pcall(function()
            local args = {1, targetPos, "AH2"}
            local knifeLocal = gun:FindFirstChild("KnifeLocal")
            if knifeLocal then
                local createBeam = knifeLocal:FindFirstChild("CreateBeam")
                if createBeam then
                    local remoteFunc = createBeam:FindFirstChild("RemoteFunction")
                    if remoteFunc then
                        remoteFunc:InvokeServer(unpack(args))
                    end
                end
            end
        end)
        pcall(function()
            local shootRemote = gun:FindFirstChild("Shoot")
            if shootRemote then
                shootRemote:FireServer(CFrame.new(origin), CFrame.new(targetPos))
            end
        end)
        Notify("AUTO SHOOT", "Shot fired at murderer!")
    end

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 180, 0, 40)
    frame.Position = UDim2.new(0.5, -90, 0.5, -20)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    frame.Parent = ScreenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 70)
    stroke.Thickness = 1
    stroke.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -12, 1, 0)
    label.Position = UDim2.new(0, 6, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = "🔫 Shoot Murder"
    label.TextColor3 = Color3.fromRGB(240, 240, 245)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.Parent = frame

    -- Drag / tap detection
    local dragData = { isDragging = false, startPos = nil, startMousePos = nil, hasMoved = false }
    local DRAG_THRESHOLD = 10

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragData.isDragging = true
            dragData.startPos = frame.Position
            dragData.startMousePos = input.Position
            dragData.hasMoved = false
        end
    end)

    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragData.isDragging = false
            if not dragData.hasMoved then
                shootMurderOnce()
            end
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragData.isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragData.startMousePos
            if delta.Magnitude > DRAG_THRESHOLD then
                dragData.hasMoved = true
            end
            local newPos = UDim2.new(
                dragData.startPos.X.Scale, dragData.startPos.X.Offset + delta.X,
                dragData.startPos.Y.Scale, dragData.startPos.Y.Offset + delta.Y
            )
            frame.Position = newPos
        end
    end)

    autoShootStandaloneFrame = frame
end

