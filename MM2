--============================================================--
local function refreshCoinCache()
    cachedCoins = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == "Coin_Server" then
            table.insert(cachedCoins, obj)
        end
    end
    lastCoinRefresh = tick()
end

local function handleFullBag()
    if not State.FlingOnMaxBag then
        currentCoins = 0
        visitedPositions = {}
        return
    end

    if isFlinging then return end
    isFlinging = true

    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then
        farmingPosition = root.CFrame
        getgenv().OldPos = farmingPosition
    end

    local murderer = nil
    for i = 1, 8 do
        murderer = getMurderer()
        if murderer then break end
        task.wait(0.4)
    end

    if not murderer then
        currentCoins = 0
        isFlinging = false
        return
    end

    local attempts = 0
    while attempts < 8 and isFlinging and State.AutoFarm do
        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.CharacterAdded:Wait()
        end
        if not murderer.Character or not murderer.Character:FindFirstChild("HumanoidRootPart") then
            murderer = getMurderer()
            if not murderer then break end
        end
        pcall(SkidFling, murderer)
        attempts = attempts + 1
        task.wait(0.45)
    end

    if farmingPosition and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = farmingPosition
    end
    currentCoins = 0
    visitedPositions = {}
    isFlinging = false
    farmingPosition = nil
end

function toggleAutoFarm(state)
    State.AutoFarm = state
    State.AntiAFK = state

    if state then
        visitedPositions = {}
        currentCoins = 0
        refreshCoinCache()

        if not getgenv()._DD_AntiAFK then
            getgenv()._DD_AntiAFK = LocalPlayer.Idled:Connect(function()
                if State.AntiAFK then
                    VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                    task.wait(1)
                    VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                end
            end)
        end

        if autoFarmCollisionConn then autoFarmCollisionConn:Disconnect() end
        autoFarmCollisionConn = RunService.Stepped:Connect(function()
            if State.AutoFarm and LocalPlayer.Character then
                for _, v in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if v:IsA("BasePart") then
                        v.CanCollide = false
                    end
                end
            end
        end)

        task.spawn(function()
            while State.AutoFarm do
                local character = LocalPlayer.Character
                if not character then
                    task.wait(0.4)
                    continue
                end
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if not rootPart then
                    task.wait(0.4)
                    continue
                end

                if currentCoins >= maxCoins then
                    handleFullBag()
                end

                if tick() - lastCoinRefresh > 1 then
                    refreshCoinCache()
                end

                local closest, shortest = nil, math.huge
                for _, obj in ipairs(cachedCoins) do
                    if obj and obj.Parent and obj:IsDescendantOf(workspace) and not visitedPositions[obj] then
                        local dist = (obj.Position - rootPart.Position).Magnitude
                        if dist < shortest and dist < 300 then
                            closest = obj
                            shortest = dist
                        end
                    end
                end

                if closest then
                    local distance = (closest.Position - rootPart.Position).Magnitude
                    local duration = math.clamp(distance / flySpeed, 0.15, 2.5)
                    local tween = TweenService:Create(rootPart, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
                        CFrame = CFrame.new(closest.Position)
                    })
                    tween:Play()
                    tween.Completed:Wait()
                    if closest and closest.Parent then
                        visitedPositions[closest] = true
                        currentCoins = currentCoins + 1
                    end
                end
                task.wait(0.18)
            end
        end)
    else
        if autoFarmCollisionConn then
            autoFarmCollisionConn:Disconnect()
            autoFarmCollisionConn = nil
        end
        isFlinging = false
    end
end

task.spawn(function()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local gameplay = remotes:FindFirstChild("Gameplay")
        if gameplay then
            local coinsStarted = gameplay:FindFirstChild("CoinsStarted")
            if coinsStarted then
                coinsStarted.OnClientEvent:Connect(function(data)
                    if data and data.Coin then
                        currentCoins = data.Coin.CollectedAmount or 0
                        maxCoins = data.Coin.CollectionLimit or 40
                        visitedPositions = {}
                        refreshCoinCache()
                    end
                end)
            end
            local coinCollected = gameplay:FindFirstChild("CoinCollected")
            if coinCollected then
                coinCollected.OnClientEvent:Connect(function(_, collected, limit)
                    currentCoins = collected or currentCoins
                    maxCoins = limit or 40
                end)
            end
        end
    end
end)

