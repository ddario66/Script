local function getToolFromAsset(obj)
    if obj:IsA("Tool") then return obj end
    return obj:FindFirstChildOfClass("Tool")
end

local function loadPrankBomb()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return nil end
    if loadedPrankTool and loadedPrankTool.Parent == backpack then
        return loadedPrankTool
    end

    local success, newTool = false, nil
    local assetId = "rbxassetid://342187115"

    local ok1, objects = pcall(function() return game:GetObjects(assetId) end)
    if ok1 and objects then
        for _, obj in ipairs(objects) do
            local tool = getToolFromAsset(obj)
            if tool then
                newTool = tool
                tool.Parent = backpack
                success = true
                break
            end
        end
        if not success then
            for _, obj in ipairs(objects) do obj:Destroy() end
        end
    end

    if not success then
        pcall(function()
            local asset = InsertService:LoadAsset(342187115)
            if asset then
                local tool = getToolFromAsset(asset)
                if tool then
                    newTool = tool
                    tool.Parent = backpack
                    success = true
                else
                    asset:Destroy()
                end
            end
        end)
    end

    if not success then
        for _, v in ipairs(game:GetDescendants()) do
            if v:IsA("Tool") and (v.Name == "Prank Bomb" or v.Name:lower():find("prank") or v.Name:lower():find("bomb")) then
                newTool = v:Clone()
                newTool.Parent = backpack
                success = true
                break
            end
        end
    end

    if success and newTool then
        loadedPrankTool = newTool
        return newTool
    end
    return nil
end

local function setupPrankTool(tool)
    if not tool then return end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end

    if tool:FindFirstChild("ActivatedConnection") then
        local old = tool.ActivatedConnection
        if old.Value and typeof(old.Value) == "RBXScriptConnection" then
            old.Value:Disconnect()
        end
        old:Destroy()
    end

    local connection = tool.Activated:Connect(function()
        local character = LocalPlayer.Character
        if not character then return end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end

        local clone = handle:Clone()
        clone.Parent = workspace
        clone.CFrame = CFrame.new(rootPart.Position + Vector3.new(0, -2.5, 0))
        clone.Anchored = false
        clone.CanCollide = true
        clone.Velocity = Vector3.new(0, 15, 0)
        Debris:AddItem(clone, 5)
    end)

    local connectionValue = Instance.new("ObjectValue")
    connectionValue.Name = "ActivatedConnection"
    connectionValue.Value = connection
    connectionValue.Parent = tool
end

function togglePrankBomb(state)
    if state then
        loadedPrankTool = loadPrankBomb()
        if loadedPrankTool then setupPrankTool(loadedPrankTool) end

        prankBombLoop = task.spawn(function()
            while State.PrankBomb do
                task.wait(0.8)
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                if not backpack then continue end

                if not loadedPrankTool or loadedPrankTool.Parent ~= backpack then
                    loadedPrankTool = loadPrankBomb()
