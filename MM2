Section(PageMisc, "Teleport")
local function teleportToMap()
    if not LocalPlayer.Character then Notify("TELEPORT", "No character found.") return end
    local map = nil
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:FindFirstChild("CoinContainer") and obj:FindFirstChild("Spawns") then
            map = obj
            break
        end
    end
    if not map then Notify("TELEPORT", "No map found.") return end
    local spawnsFolder = map:FindFirstChild("Spawns")
    if not spawnsFolder then Notify("TELEPORT", "No spawns folder.") return end
    local spawns = spawnsFolder:GetChildren()
    if #spawns == 0 then Notify("TELEPORT", "No spawn points.") return end
    local randomSpawn = spawns[math.random(1, #spawns)]
    LocalPlayer.Character:MoveTo(randomSpawn.Position)
    Notify("TELEPORT", "Teleported to a random spawn point.")
end
local function teleportToLobby()
    if not LocalPlayer.Character then Notify("TELEPORT", "No character found.") return end
    local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then Notify("TELEPORT", "No HumanoidRootPart.") return end
    local pos = Vector3.new(0, 0, 0)  -- Nikilis lobby coordinates
    rootPart.CFrame = CFrame.new(pos)
    Notify("TELEPORT", "Teleported to Nikilis lobby.")
end
ActionButton(PageMisc, "Teleport to Map", "Go to a random spawn point on the map.", teleportToMap)
ActionButton(PageMisc, "Teleport to Lobby", "Go to the lobby (exact coordinates).", teleportToLobby)

