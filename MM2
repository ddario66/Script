function startAutoShoot()
    if autoShootConnection then autoShootConnection:Disconnect() end
    if not State.AutoShootGun then return end

    autoShootConnection = RunService.Heartbeat:Connect(function()
        local sheriff = LocalPlayer
        if not sheriff.Character or not sheriff.Character:FindFirstChild("Gun") then return end

        local murderer = getMurderer()
        if not murderer or not murderer.Character then return end

        local origin = sheriff.Character.HumanoidRootPart.Position
        local targetPos = murderer.Character.HumanoidRootPart.Position
        local direction = (targetPos - origin).Unit * 500
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {sheriff.Character}

        local result = workspace:Raycast(origin, direction, rayParams)
        if result and result.Instance:IsDescendantOf(murderer.Character) then
            local gun = sheriff.Character:FindFirstChild("Gun")
            if gun then
                pcall(function()
                    local args = {1, targetPos, "AH2"}
                    gun:FindFirstChild("KnifeLocal"):FindFirstChild("CreateBeam"):FindFirstChild("RemoteFunction"):InvokeServer(unpack(args))
                end)
                pcall(function()
                    gun:FindFirstChild("Shoot"):FireServer(CFrame.new(origin), CFrame.new(targetPos))
                end)
            end
        end
    end)
end

function startGunGrabber()
    if gunDropConnection then gunDropConnection:Disconnect() end
    if not State.AutoGrabGun then return end

    local function grabGunDrop(gunDrop)
        if gunDropProcessed[gunDrop] then return end
        gunDropProcessed[gunDrop] = true

        task.wait(0.5)
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            gunDropProcessed[gunDrop] = nil
            return
        end
        local rootPart = char.HumanoidRootPart
        local previousCFrame = rootPart.CFrame
        rootPart.CFrame = gunDrop:GetPivot() + Vector3.new(0, 2, 0)
        task.wait(0.5)
        rootPart.CFrame = previousCFrame

        task.delay(3, function()
            gunDropProcessed[gunDrop] = nil
        end)
    end

    -- existing drops
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "GunDrop" then
            grabGunDrop(obj)
        end
    end

    -- new drops
    gunDropConnection = workspace.DescendantAdded:Connect(function(obj)
        if obj.Name == "GunDrop" then
            grabGunDrop(obj)
        end
    end)
end

function killAllAsMurder()
    local murderer = LocalPlayer
    if getPlayerRole(murderer) ~= "Murderer" then
        Notify("KILL ALL", "You are not the murderer!")
        return
    end

    local function equipKnife()
        local knife = murderer.Character and murderer.Character:FindFirstChild("Knife")
        if not knife then
            local backpackKnife = murderer.Backpack:FindFirstChild("Knife")
            if backpackKnife then
                local hum = murderer.Character and murderer.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum:EquipTool(backpackKnife)
                    task.wait(0.2)
                end
            end
        end
        return murderer.Character and murderer.Character:FindFirstChild("Knife")
    end

    local knife = equipKnife()
    if not knife then
        Notify("KILL ALL", "Could not find knife.")
        return
    end

    local function getAliveTargets()
        local targets = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= murderer and player.Character then
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    table.insert(targets, player)
                end
            end
        end
        return targets
    end

    local maxIterations = 20
    local iteration = 0
    while iteration < maxIterations do
        iteration = iteration + 1
        local targets = getAliveTargets()
        if #targets == 0 then
            Notify("KILL ALL", "All players are dead!")
            break
        end

        for _, player in ipairs(targets) do
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                hrp.Anchored = true
                hrp.CFrame = murderer.Character.HumanoidRootPart.CFrame + murderer.Character.HumanoidRootPart.CFrame.LookVector * 2
            end
        end

        local stabRemote = knife:FindFirstChild("Stab")
        if stabRemote then
            stabRemote:FireServer("Slash")
        else
            local attackRemote = knife:FindFirstChild("Attack")
            if attackRemote then attackRemote:FireServer() end
        end

        task.wait(0.5)
        for _, player in ipairs(targets) do
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                player.Character.HumanoidRootPart.Anchored = false
            end
        end
        task.wait(0.3)
        knife = equipKnife() or knife
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= murderer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.Anchored = false
        end
    end
    Notify("KILL ALL", "Finished.")
end

