local function startRoleMonitor()
    if roleMonitorConnection then return end
    roleMonitorConnection = RunService.Heartbeat:Connect(function()
        if State.ChatMurderName then
            local murderer = getMurderer()
            local name = murderer and murderer.Name or nil
            if name and name ~= lastMurdererName then
                say(name .. " is murder!")
                lastMurdererName = name
            elseif not name then
                lastMurdererName = nil
            end
        else
            lastMurdererName = nil
        end

        if State.ChatSheriffName then
            local sheriff = getSheriff()
            local name = sheriff and sheriff.Name or nil
            if name and name ~= lastSheriffName then
                say(name .. " is sheriff!")
                lastSheriffName = name
            elseif not name then
                lastSheriffName = nil
            end
        else
            lastSheriffName = nil
        end
    end)
end

