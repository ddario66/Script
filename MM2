local function SwitchPage(name)
    for pageName, page in pairs(Tabs.Pages) do page.Visible = (pageName == name) end
    PageTitle.Text = name
    local descriptions = {
        INFO="Profile and script information", COMBAT="Combat features", FLING="Fling utilities",
        ESP="Visual and role detection", MISC="Miscellaneous features", BUTTONS="Standalone controls",
        SETTINGS="Interface and movement settings",
    }
    PageDescription.Text = descriptions[name] or ""
    for tabName, button in pairs(Tabs.Buttons) do
        local active = tabName == name
        Tween(button, {BackgroundColor3 = active and UI.Red2 or UI.Surface2}, 0.18)
        local bar = button:FindFirstChild("ActiveBar")
        if bar then Tween(bar, {BackgroundTransparency = active and 0 or 1}, 0.18) end
        local icon = button:FindFirstChild("Icon")
        local label = button:FindFirstChild("Label")
        if icon then Tween(icon, {TextColor3 = active and UI.White or UI.Muted}, 0.18) end
        if label then Tween(label, {TextColor3 = active and UI.White or UI.Muted}, 0.18) end
    end
end

